{
  "name": "ai-video-generator",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @ai-video/web dev",
    "dev:web": "pnpm --filter @ai-video/web dev",
    "dev:api": "pnpm --filter @ai-video/api dev",
    "worker": "pnpm --filter @ai-video/api worker",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "build": "pnpm --filter @ai-video/api build && pnpm --filter @ai-video/web build",
    "typecheck": "pnpm --filter @ai-video/api typecheck && pnpm --filter @ai-video/web typecheck",
    "lint": "pnpm --filter @ai-video/api lint && pnpm --filter @ai-video/web lint"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
